{
  "manifest_version": 3,
  "name": "نسق — تحضير سريع",
  "description": "حضّر حصص الأسبوع كلها من نسق بضغطة واحدة، كل حصة بدرسها.",
  "version": "1.2.0",

  "icons": {
    "16": "logo/nasaq logo.jpeg",
    "32": "logo/nasaq logo.jpeg",
    "48": "logo/nasaq logo.jpeg",
    "128": "logo/nasaq logo.jpeg"
  },

  "action": {
    "default_title": "نسق — تحضير سريع",
    "default_icon": "logo/nasaq logo.jpeg",
    "default_popup": "popup.html"
  },

  "background": { "service_worker": "background.js" },

  "permissions": ["storage", "cookies"],

  "host_permissions": [
    "https://nasaqedu.org/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://nasaqedu.org/*",
        "http://127.0.0.1:5000/*",
        "http://localhost:5000/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5173/*"
      ],
      "js": ["core.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
